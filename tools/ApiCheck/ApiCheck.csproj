<Project Sdk="Microsoft.NET.Sdk">
  <!-- Offline check: resolves every type and member HARTModPack.dll uses against a folder of game assemblies,
       without running anything. Usage: tools/check-api.sh [game Managed folder] -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
</Project>
