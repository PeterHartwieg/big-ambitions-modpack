<Project Sdk="Microsoft.NET.Sdk">
  <!-- Prints each mod folder's root DLL: assembly simple name, AssemblyVersion and AssemblyInformationalVersion.
       Reads metadata only, so nothing from the mods runs. Used to fill Core/TestedVersions.cs. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
</Project>
